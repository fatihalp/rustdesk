APP_NAME="Remote Support Panel"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=tr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=rustdesk_panel
DB_USERNAME=panel
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Remote support (see README.md)
# Public URL of this panel as the client sees it (the client calls {PANEL_API_URL}/api/heartbeat). Use https in production.
PANEL_API_URL="${APP_URL}"
# Relay server (relay/ folder): hbbs host and the public key from relay/data/id_ed25519.pub
PANEL_RENDEZVOUS_SERVER=relay.example.com
PANEL_RELAY_SERVER=
PANEL_RELAY_KEY=
# A device counts as online when its last heartbeat is newer than this many seconds
PANEL_ONLINE_SECONDS=90
# Where signed installers are stored (any filesystem disk from config/filesystems.php)
PANEL_BUILDS_DISK=local
# GitHub Actions workflow that builds, brands and signs the client
PANEL_GITHUB_REPOSITORY=
PANEL_GITHUB_TOKEN=
PANEL_GITHUB_WORKFLOW=brand-package.yml
PANEL_GITHUB_REF=master
# Shared secret used by the workflow to fetch the brand manifest and upload signed files
PANEL_BUILD_SECRET=
# First admin created by `php artisan db:seed`
PANEL_ADMIN_EMAIL=admin@example.com
PANEL_ADMIN_PASSWORD=
