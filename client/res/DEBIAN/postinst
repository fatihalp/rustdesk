#!/bin/bash

set -e

if [ "$1" = configure ]; then

	INITSYS=$(ls -al /proc/1/exe | awk -F' ' '{print $NF}' | awk -F'/' '{print $NF}')
	ln -f -s /usr/share/supportdesk/supportdesk /usr/bin/supportdesk

	if [ "systemd" == "$INITSYS" ]; then

		if [ -e /etc/systemd/system/supportdesk.service ]; then
			rm -f /etc/systemd/system/supportdesk.service /usr/lib/systemd/system/supportdesk.service /usr/lib/systemd/user/supportdesk.service >/dev/null  2>&1
		fi
		mkdir -p /usr/lib/systemd/system/
		cp /usr/share/supportdesk/files/systemd/supportdesk.service /usr/lib/systemd/system/supportdesk.service
		# try fix error in Ubuntu 18.04
		# Failed to reload supportdesk.service: Unit supportdesk.service is not loaded properly: Exec format error.
		# /usr/lib/systemd/system/supportdesk.service:10: Executable path is not absolute: pkill -f "supportdesk --"
		if [ -e /usr/bin/pkill ]; then
			sed -i "s|pkill|/usr/bin/pkill|g" /usr/lib/systemd/system/supportdesk.service
		fi
		systemctl daemon-reload
		systemctl enable supportdesk
		systemctl start supportdesk
	fi
fi
